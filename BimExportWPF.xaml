<Window x:Class="TNovBIMUtils.BimExportWPF"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:local="clr-namespace:TNovBIMUtils"
        mc:Ignorable="d"
        MinHeight="700"
        Height="700"
        MinWidth="800"
        Width="800"
        WindowStartupLocation="CenterOwner"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="CanResize"
        WindowStyle="None">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/TNovCommon;component/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <local:InverseConverter x:Key="InverseConverter"/>
        </ResourceDictionary>
    </Window.Resources>

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="30"
                      ResizeBorderThickness="5"
                      GlassFrameThickness="0"
                      CornerRadius="12"/>
    </WindowChrome.WindowChrome>

    <Border CornerRadius="12"
            Background="{StaticResource BgBrush}"
            BorderBrush="{StaticResource AccentBrush}"
            BorderThickness="1">
        <Grid Margin="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" MouseDown="TitleBar_MouseDown" Background="Transparent" Cursor="Arrow" Margin="6,6,6,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="35"/>
                        <ColumnDefinition Width="35"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="BIM ЭКСПОРТ"
                               Grid.Column="0"
                               Foreground="{StaticResource AccentBrush}"
                               FontSize="22"
                               FontWeight="Bold"
                               VerticalAlignment="Center"/>
                    <Button Content="i"
                            Grid.Column="1"
                            HorizontalAlignment="Right"
                            Style="{StaticResource CloseButtonStyleMini}"
                            Click="HelpButton_Click"
                            WindowChrome.IsHitTestVisibleInChrome="True"/>
                    <Button Content="✕"
                            Grid.Column="2"
                            HorizontalAlignment="Right"
                            Style="{StaticResource CloseButtonStyleMini}"
                            Click="escButton_Click"
                            WindowChrome.IsHitTestVisibleInChrome="True"/>
                </Grid>
            </Border>

            <Border Grid.Row="1" Style="{StaticResource PanelFrameStyle}" Margin="0,0,0,8" Padding="10,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="Источник:"
                               Foreground="{StaticResource MutedBrush}"
                               FontSize="12"
                               VerticalAlignment="Center"
                               Margin="0,0,10,0"/>
                    <Button Grid.Column="1"
                            Content="Revit Server"
                            x:Name="browseButtonRS"
                            Style="{StaticResource RevitServerButtonStyle}"
                            Click="browseButtonRS_Click"/>
                    <Button Grid.Column="2"
                            Content="Выбрать папку"
                            x:Name="browseButton"
                            Style="{StaticResource FolderSourceButtonStyle}"
                            Click="browseButton_Click"/>
                    <TextBox Grid.Column="3"
                             Name="textBox1"
                             Text="{Binding folder, UpdateSourceTrigger=PropertyChanged}"
                             MinWidth="160"
                             Style="{StaticResource DarkCompactTextBoxStyle}"
                             VerticalAlignment="Center"
                             FontSize="11"
                             HorizontalAlignment="Stretch"
                             TextChanged="textBox1_TextChanged"/>
                    <TextBox Name="textBox1RS"
                             Text="{Binding folderRS}"
                             Width="0"
                             Height="0"
                             Visibility="Collapsed"/>
                </Grid>
            </Border>

            <Grid Grid.Row="2" x:Name="ContentGrid">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="350"/>
                    <ColumnDefinition x:Name="ExtraColumn" Width="0"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Style="{StaticResource PanelFrameStyle}"
                        Margin="0,0,5,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="Revit Server" Style="{StaticResource PanelHeaderStyle}"/>
                        <TreeView Grid.Row="1"
                                  x:Name="treeView"
                                  Style="{StaticResource DarkTreeViewStyle}"
                                  ItemContainerStyle="{StaticResource DarkTreeViewItemStyle}"
                                  ItemsSource="{Binding Nodes, Mode=TwoWay}"
                                  ScrollViewer.VerticalScrollBarVisibility="Auto"
                                  VerticalAlignment="Stretch">
                            <TreeView.ItemTemplate>
                                <HierarchicalDataTemplate ItemsSource="{Binding Children, Mode=TwoWay}">
                                    <StackPanel Orientation="Horizontal">
                                        <ToggleButton IsChecked="{Binding IsChecked, Mode=TwoWay}"
                                                      IsEnabled="{Binding IsLocked, Converter={StaticResource InverseConverter}}"
                                                      Style="{StaticResource TreeCheckToggleStyle}"
                                                      Uid="{Binding Id}"/>
                                        <TextBlock Text="{Binding Text}" Foreground="White" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </HierarchicalDataTemplate>
                            </TreeView.ItemTemplate>
                        </TreeView>
                    </Grid>
                </Border>

                <StackPanel Grid.Column="1"
                            Margin="5,0,0,0"
                            VerticalAlignment="Top">
                    <Border Style="{StaticResource PanelFrameStyle}"
                            Margin="0,0,0,8">
                        <StackPanel>
                            <TextBlock Text="Настройки NWC" Style="{StaticResource PanelHeaderStyle}"/>
                            
                                <ToggleButton Style="{StaticResource CardToggleStyle}"
                                              x:Name="NWC"
                                              IsChecked="{Binding NWC}"
                                              Margin="0,0,6,6"
                                              Padding="10,8">
                                    <TextBlock Text="Выгрузить NWC" Style="{StaticResource CardTitleStyle}"/>
                                </ToggleButton>
                                <ToggleButton Style="{StaticResource CardToggleStyle}"
                                              x:Name="NWCNova"
                                              IsChecked="{Binding NWCNova}"
                                              Margin="0,0,0,6"
                                              Padding="10,8">
                                    <TextBlock Text="С вида Nova (внутренние проверки)" Style="{StaticResource CardTitleStyle}"/>
                                </ToggleButton>
                            
                            <TextBlock Text="Каталог для NWC:"
                                       Foreground="{StaticResource MutedBrush}"
                                       FontSize="12"
                                       Margin="0,0,0,4"/>
                            <ComboBox x:Name="NWCbox"
                                      Style="{StaticResource DarkComboBoxStyle}"
                                      Margin="0,0,0,6"
                                      SelectionChanged="NWCbox_SelectionChanged"/>
                            <TextBox Name="textBox2"
                                     Text="{Binding folder2, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource DarkCompactTextBoxStyle}"
                                     Margin="0,0,0,6"
                                     TextChanged="textBox2_TextChanged"/>
                            <Button Style="{StaticResource SecondaryButtonStyle}"
                                    Content="Выбрать каталог для NWC"
                                    x:Name="browseButton2"
                                    Click="browseButton2_Click"
                                    HorizontalAlignment="Stretch"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource PanelFrameStyle}"
                            Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="Настройки выдачи" Style="{StaticResource PanelHeaderStyle}"/>
                            <ToggleButton Style="{StaticResource CardToggleStyle}"
                                          x:Name="RVT"
                                          IsChecked="{Binding RVT}"
                                          Margin="0,0,0,6"
                                          Padding="10,8">
                                <TextBlock Text="Выгрузить очищенные RVT" Style="{StaticResource CardTitleStyle}"/>
                            </ToggleButton>
                            <TextBox Name="textBox3"
                                     Text="{Binding folder3, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource DarkCompactTextBoxStyle}"
                                     Margin="0,0,0,6"/>
                            <Button Style="{StaticResource SecondaryButtonStyle}"
                                    Content="Выбрать каталог на выдачу"
                                    x:Name="browseButton3"
                                    Click="browseButton3_Click"
                                    HorizontalAlignment="Stretch"/>
                        </StackPanel>
                    </Border>

                    <ToggleButton Style="{StaticResource CardToggleStyle}"
                                  x:Name="extraSettingsToggle"
                                  Margin="0,0,0,8"
                                  Padding="10,8"
                                  Checked="ExtraSettingsToggle_Checked"
                                  Unchecked="ExtraSettingsToggle_Unchecked">
                        <TextBlock Name="extSettings_text" Text="Дополнительные настройки >" Style="{StaticResource CardTitleStyle}"/>
                    </ToggleButton>

                    <Button Content="Запуск"
                            Style="{StaticResource RunButtonStyle}"
                            x:Name="acceptButton"
                            Margin="0,10,0,0"
                            IsDefault="True"
                            Click="acceptButton_Click"/>
                </StackPanel>

                <StackPanel Grid.Column="2"
                            x:Name="ExtraSettingsPanel"
                            Visibility="Collapsed"
                            Margin="5,0,0,0"
                            VerticalAlignment="Top">
                    <Border Style="{StaticResource PanelFrameStyle}"
                            Margin="0,0,0,8">
                        <StackPanel>
                            <TextBlock Text="Фильтры" Style="{StaticResource PanelHeaderStyle}"/>
                            <WrapPanel>
                                <ToggleButton x:Name="AR" Style="{StaticResource FilterToggleStyle}" IsChecked="{Binding AR}">
                                    <TextBlock Text="АР" Style="{StaticResource CardTitleStyle}"/>
                                </ToggleButton>
                                <ToggleButton x:Name="ST" Style="{StaticResource FilterToggleStyle}" IsChecked="{Binding ST}">
                                    <TextBlock Text="КЖ" Style="{StaticResource CardTitleStyle}"/>
                                </ToggleButton>
                                <ToggleButton x:Name="VK" Style="{StaticResource FilterToggleStyle}" IsChecked="{Binding VK}">
                                    <TextBlock Text="ВК" Style="{StaticResource CardTitleStyle}"/>
                                </ToggleButton>
                                <ToggleButton x:Name="OV" Style="{StaticResource FilterToggleStyle}" IsChecked="{Binding OV}">
                                    <TextBlock Text="ОВ" Style="{StaticResource CardTitleStyle}"/>
                                </ToggleButton>
                                <ToggleButton x:Name="EL" Style="{StaticResource FilterToggleStyle}" IsChecked="{Binding EL}">
                                    <TextBlock Text="ЭЛ" Style="{StaticResource CardTitleStyle}"/>
                                </ToggleButton>
                                <ToggleButton x:Name="SS" Style="{StaticResource FilterToggleStyle}" IsChecked="{Binding SS}">
                                    <TextBlock Text="СС" Style="{StaticResource CardTitleStyle}"/>
                                </ToggleButton>
                            </WrapPanel>
                            <StackPanel Margin="0,8,0,0">
                                <TextBlock Text="Фильтр по имени:"
                                           Foreground="{StaticResource MutedBrush}"
                                           FontSize="12"
                                           Margin="0,0,0,4"/>
                                <TextBox Name="textBox4"
                                         Text="{Binding namefilter}"
                                         Style="{StaticResource DarkTextBoxStyle}"/>
                            </StackPanel>
                            <ToggleButton Style="{StaticResource CardToggleStyle}"
                                          x:Name="NWC2"
                                          IsChecked="{Binding NWC2}"
                                          Margin="0,8,0,0"
                                          Padding="10,8">
                                <TextBlock Text="NWC в папку выдачи" Style="{StaticResource CardTitleStyle}"/>
                            </ToggleButton>
                        </StackPanel>
                    </Border>

                    <Button Style="{StaticResource SecondaryButtonStyle}"
                            Content="Редактировать список проектов"
                            x:Name="cdeButton"
                            Click="cdeButton_Click"
                            Margin="0,0,0,8"
                            HorizontalAlignment="Stretch"/>
                    <Button Style="{StaticResource SecondaryButtonStyle}"
                            Content="Открыть журнал автоэкспорта"
                            x:Name="autoButton"
                            Click="autoButton_Click"
                            HorizontalAlignment="Stretch"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
