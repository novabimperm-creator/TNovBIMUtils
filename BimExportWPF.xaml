<Window x:Class="TNovBIMUtils.BimExportWPF"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
        xmlns:local="clr-namespace:TNovBIMUtils"
        mc:Ignorable="d" 
        MinHeight="620" Height="620"
        MinWidth="800" Width="800"
        WindowStartupLocation="CenterScreen" 
        AllowsTransparency="True"
        Background="Transparent" 
        ResizeMode="CanResize" 
        WindowStyle="None">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/TNovCommon;component/ButtonStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <local:InverseConverter x:Key="InverseConverter"/>
        </ResourceDictionary>
    </Window.Resources>
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="30"
                      ResizeBorderThickness="5"
                      GlassFrameThickness="0"
                      CornerRadius="12"/>
    </WindowChrome.WindowChrome>
    <Border CornerRadius="12"
            Background="White"
            BorderBrush="#FF008E43"
            BorderThickness="1">
        <Grid>
            <!-- Верхняя панель (кастомный заголовок) -->
            <Border Height="30" 
                    CornerRadius="12 12 0 0"
                    Background="#FF008E43" 
                    VerticalAlignment="Top"
                    MouseDown="Border_MouseDown">
                <StackPanel Orientation="Horizontal">
                    <Button Style="{StaticResource RoundButtonStyle}" 
                            Click="escButton_Click" Content="✕"
                            HorizontalAlignment="Center" VerticalAlignment="Center"
                            Width="20" Height="20" Margin="5,0"
                            WindowChrome.IsHitTestVisibleInChrome="True"/>
                    <Button Style="{StaticResource RoundButtonStyle2}" 
                            Click="HelpButton_Click" Content="?"
                            HorizontalAlignment="Center" VerticalAlignment="Center"
                            Width="20" Height="20" Margin="0"
                            WindowChrome.IsHitTestVisibleInChrome="True"/>
                    <TextBlock Text="BIM Экспорт" 
                               Foreground="White"
                               VerticalAlignment="Center"
                               Margin="10,0"/>
                </StackPanel>
            </Border>

            <!-- Основное содержимое -->
            <Border Margin="5,30,5,5">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <!-- Источник данных -->
                        <RowDefinition Height="*"/>
                        <!-- Основная область с TreeView и правыми настройками -->
                    </Grid.RowDefinitions>

                    <!-- Источник данных -->
                    <GroupBox Grid.Row="0" Header="Источник данных" Padding="5" BorderBrush="#FF008E43">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                            <Button Style="{StaticResource CustomButtonStyle}" Content="Revit Server" x:Name="browseButtonRS" Click="browseButtonRS_Click" Width="100" MinHeight="25" Margin="5" />
                            <RadioButton BorderBrush="#CCCCCC" x:Name="rs" GroupName="rvt" IsThreeState="False" Margin="0 0 5 0" IsChecked="{Binding fromRS}" VerticalAlignment="Center"  />
                            <TextBox Name="textBox1RS" Text="{Binding folderRS}" Width="0" TextAlignment="Center" TextWrapping="Wrap" MaxHeight="25" />
                            <RadioButton BorderBrush="#CCCCCC" x:Name="rvt" GroupName="rvt" IsThreeState="False" IsChecked="{Binding fromRVT}" VerticalAlignment="Center"  />
                            <Button Style="{StaticResource CustomButtonStyle}" Content="Выбрать папку" x:Name="browseButton" Click="browseButton_Click" Width="100" MinHeight="25" Margin="5" />
                            <TextBox Name="textBox1" Text="{Binding folder}" Width="500" Margin="5" MinHeight="25" TextAlignment="Center"  TextWrapping="Wrap" TextChanged="textBox1_TextChanged" BorderBrush="#CCCCCC"/>
                        </StackPanel>
                    </GroupBox>

                    <!-- Основная сетка с двумя колонками -->
                    <Grid Grid.Row="1" Margin="0,5,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="350"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Левая колонка (растягивается по ширине и высоте) -->
                        <GroupBox Grid.Column="0" Grid.Row="0"
                                  Header="Revit Server" 
                                  Padding="5" 
                                  BorderBrush="#FF008E43"
                                  Margin="0,0,5,0"
                                  VerticalAlignment="Stretch"
                                  VerticalContentAlignment="Stretch">
                            <TreeView x:Name="treeView"
                                      BorderBrush="{x:Null}"
                                      BorderThickness="0"
                                      ItemsSource="{Binding Path=Nodes, Mode=TwoWay}"
                                      ScrollViewer.VerticalScrollBarVisibility="Auto"
                                      VerticalAlignment="Stretch">
                                <TreeView.ItemTemplate>
                                    <HierarchicalDataTemplate ItemsSource="{Binding Path=Children, Mode=TwoWay}">
                                        <StackPanel Orientation="Horizontal">
                                            <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}"
                                                      IsEnabled="{Binding IsLocked, Converter={StaticResource InverseConverter}}"
                                                      Uid="{Binding Id}" />
                                            <TextBlock Text="{Binding Text}" />
                                        </StackPanel>
                                    </HierarchicalDataTemplate>
                                </TreeView.ItemTemplate>
                            </TreeView>
                        </GroupBox>

                        <!-- Правая колонка (фиксированная ширина, прижата к нижнему углу) -->
                        <StackPanel Grid.Column="1" Grid.Row="0"
                                    Orientation="Vertical" 
                                    VerticalAlignment="Bottom"
                                    Margin="5,0,0,0">
                            <GroupBox Header="Фильтры" Padding="5" BorderBrush="#FF008E43">
                                <StackPanel Orientation="Vertical" HorizontalAlignment="Left">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                        <CheckBox x:Name="AR" IsThreeState="False" IsChecked="{Binding AR}" Content="АР" Margin="5" VerticalAlignment="Center" BorderBrush="#CCCCCC"/>
                                        <CheckBox x:Name="ST" IsThreeState="False" IsChecked="{Binding ST}" Content="КЖ" Margin="5" VerticalAlignment="Center" BorderBrush="#CCCCCC"/>
                                        <CheckBox x:Name="VK" IsThreeState="False" IsChecked="{Binding VK}" Content="ВК" Margin="5" VerticalAlignment="Center" BorderBrush="#CCCCCC"/>
                                        <CheckBox x:Name="OV" IsThreeState="False" IsChecked="{Binding OV}" Content="ОВ" Margin="5" VerticalAlignment="Center" BorderBrush="#CCCCCC"/>
                                        <CheckBox x:Name="EL" IsThreeState="False" IsChecked="{Binding EL}" Content="ЭЛ" Margin="5" VerticalAlignment="Center" BorderBrush="#CCCCCC"/>
                                        <CheckBox x:Name="SS" IsThreeState="False" IsChecked="{Binding SS}" Content="СС" Margin="5" VerticalAlignment="Center" BorderBrush="#CCCCCC"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                        <TextBlock Margin="5 0 0 0" Text="Фильтр по имени:" VerticalAlignment="Center" FontWeight="Bold"/>
                                        <TextBox Name="textBox4" Text="{Binding namefilter}" Width="150" MinHeight="25" Margin="5" TextAlignment="Center" TextWrapping="Wrap" BorderBrush="#CCCCCC"/>
                                    </StackPanel>
                                </StackPanel>
                            </GroupBox>

                            <GroupBox Header="Настройки NWC" Padding="5" BorderBrush="#FF008E43">
                                <StackPanel Orientation="Vertical" HorizontalAlignment="Left">
                                    <CheckBox BorderBrush="#CCCCCC" x:Name="NWC" IsThreeState="False" IsChecked="{Binding NWC}" Margin="5" Content="Выгрузить NWC" VerticalAlignment="Center" FontWeight="Bold"/>
                                    <CheckBox BorderBrush="#CCCCCC" x:Name="NWCNova" IsThreeState="False" IsChecked="{Binding NWCNova}" Content="с вида Nova (для внутр. проверок раздела)" Margin="5" VerticalAlignment="Center"/>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <TextBlock Text="Каталог для NWC:" Margin="5"></TextBlock>
                                        <ComboBox Width="200" 
x:Name="NWCbox"
SelectionChanged="NWCbox_SelectionChanged"
Margin="5">
                                        </ComboBox>
                                    </StackPanel>
                                    <TextBox Name="textBox2" Text="{Binding folder2}" Width="300" Margin="5" MinHeight="25" TextAlignment="Center" TextWrapping="Wrap" />
                                    
                                    <Button Style="{StaticResource CustomButtonStyle}" Content="Выбрать каталог для NWC" x:Name="browseButton2" Click="browseButton2_Click" Width="200" MinHeight="25" Margin="5" />
                                </StackPanel>
                            </GroupBox>

                            <GroupBox Header="Настройки выдачи" Padding="5" BorderBrush="#FF008E43">
                                <StackPanel Orientation="Vertical" HorizontalAlignment="Left">
                                    <CheckBox BorderBrush="#CCCCCC" x:Name="RVT" IsThreeState="False" IsChecked="{Binding RVT}" Content="Выгрузить очищенные RVT" Margin="5" VerticalAlignment="Center" FontWeight="Bold"/>
                                    <CheckBox BorderBrush="#CCCCCC" x:Name="NWC2" IsThreeState="False" IsChecked="{Binding NWC2}" Content="NWC в папку выдачи" Margin="5" VerticalAlignment="Center" />
                                    <TextBox Name="textBox3" Text="{Binding folder3}" Width="300" Margin="5" MinHeight="25" TextAlignment="Center" TextWrapping="Wrap" />
                                    <Button Style="{StaticResource CustomButtonStyle}" Content="Выбрать каталог на выдачу" x:Name="browseButton3" Click="browseButton3_Click" Width="200" MinHeight="25" Margin="5" />
                                </StackPanel>
                            </GroupBox>
                        </StackPanel>
                        <!-- Кнопки в левом нижнем углу -->
                        <StackPanel Grid.Column="0" Grid.Row="1" 
            VerticalAlignment="Bottom" HorizontalAlignment="Left"
            Margin="5,10,0,0">
                            <StackPanel Orientation="Horizontal">
                                <Button Style="{StaticResource CustomButtonStyle}" MinHeight="25" Content="Редактировать список проектов" x:Name="cdeButton" Click="cdeButton_Click" MinWidth="110" Margin="5"/>
                                <Button Style="{StaticResource CustomButtonStyle}" MinHeight="25" Content="Открыть журнал автоэкспорта" x:Name="autoButton" Click="autoButton_Click" MinWidth="110" Margin="5"/>
                            </StackPanel>
                        </StackPanel>
                        <!-- Кнопки в правом нижнем углу -->
                        <StackPanel Grid.Column="1" Grid.Row="1" 
                                    VerticalAlignment="Bottom" HorizontalAlignment="Right"
                                    Margin="5,10,0,0">
                            <StackPanel Orientation="Horizontal">
                                <Button Style="{StaticResource CustomButtonStyle}" Content="Отмена" x:Name="escButton" IsCancel="True" Click="escButton_Click" MinWidth="60" MinHeight="25" Margin="20 5 5 5" />
                                <Button Style="{StaticResource CustomButtonStyle}" Content="Запуск" x:Name="acceptButton" IsDefault="True" Click="acceptButton_Click" MinWidth="110" Margin="5"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>