<Window x:Class="TNovBIMUtils.TDiamExceptionsWPF"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        MinHeight="420"
        Height="480"
        MinWidth="640"
        Width="680"
        WindowStartupLocation="CenterOwner"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="CanResize"
        WindowStyle="None"
        Closing="Window_Closing">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/TNovCommon;component/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="30"
                      ResizeBorderThickness="5"
                      GlassFrameThickness="0"
                      CornerRadius="12"/>
    </WindowChrome.WindowChrome>

    <Border CornerRadius="12"
            Background="{StaticResource BgBrush}"
            BorderBrush="{StaticResource AccentBrush}"
            BorderThickness="1">
        <Grid Margin="18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" MouseDown="TitleBar_MouseDown" Background="Transparent" Cursor="Arrow" Margin="0,0,0,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="35"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="ИСКЛЮЧЕНИЯ Т_ДИАМЕТР"
                               Grid.Column="0"
                               Foreground="{StaticResource AccentBrush}"
                               FontSize="20"
                               FontWeight="Bold"
                               VerticalAlignment="Center"/>
                    <Button Content="✕"
                            Grid.Column="1"
                            HorizontalAlignment="Right"
                            Style="{StaticResource CloseButtonStyleMini}"
                            Click="CloseButton_Click"
                            WindowChrome.IsHitTestVisibleInChrome="True"/>
                </Grid>
            </Border>

            <TextBlock Grid.Row="1"
                       TextWrapping="Wrap"
                       Margin="0,0,0,10"
                       Opacity="0.85"
                       Text="Если ADSK_Наименование содержит подстроку, диаметр берётся не обычным разбором, а из указанного источника: Размер (параметр Размер / Размер трубы) или Артикул (число после точки, как 58.15 → 15). Файл общий для всех проектов."/>

            <DataGrid Grid.Row="2"
                      ItemsSource="{Binding Entries}"
                      SelectedItem="{Binding Selected}"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      RowHeaderWidth="0"
                      GridLinesVisibility="Horizontal"
                      Style="{StaticResource DarkDataGridStyle}"
                      ColumnHeaderStyle="{StaticResource DarkDataGridColumnHeaderStyle}"
                      CellStyle="{StaticResource DarkDataGridCellStyle}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Подстрока в ADSK_Наименование"
                                        Binding="{Binding Match, UpdateSourceTrigger=PropertyChanged}"
                                        Width="*"
                                        MinWidth="220"
                                        EditingElementStyle="{StaticResource DarkTextBoxStyle}"/>
                    <DataGridTemplateColumn Header="Источник" Width="160" MinWidth="120">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <ComboBox ItemsSource="{Binding DataContext.Sources, RelativeSource={RelativeSource AncestorType=Window}}"
                                          SelectedItem="{Binding Source, UpdateSourceTrigger=PropertyChanged}"
                                          Style="{StaticResource DarkComboBoxStyle}"
                                          Margin="0"
                                          IsSynchronizedWithCurrentItem="False"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>

            <Grid Grid.Row="3" Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                           Text="{Binding FilePath}"
                           TextWrapping="Wrap"
                           VerticalAlignment="Center"
                           Opacity="0.7"
                           Margin="0,0,12,0"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Добавить"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Command="{Binding AddCommand}"
                            Margin="0,0,8,0"/>
                    <Button Content="Удалить"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Command="{Binding DeleteCommand}"
                            Margin="0,0,8,0"/>
                    <Button Content="Сохранить"
                            Style="{StaticResource RunButtonStyle}"
                            Command="{Binding SaveCommand}"
                            Margin="0,0,8,0"/>
                    <Button Content="Закрыть"
                            Style="{StaticResource CloseButtonStyle}"
                            Click="CloseButton_Click"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
